{
  "name": "Jatayutechnologies",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "find:assets": "node scripts/find-unused-assets.js",
    "ios:clean": "cd ios && xcodebuild clean && rm -rf Pods Podfile.lock && pod install",
    "ios:pods": "cd ios && pod install --repo-update",
    "ios:dev": "cross-env ENVFILE=.env.development react-native run-ios",
    "ios:prod": "cross-env ENVFILE=.env.production react-native run-ios --configuration Release",
    "android:dev": "cross-env ENVFILE=.env.development react-native run-android",
    "android:prod": "cross-env ENVFILE=.env.production react-native run-android",
    "build:ios:dev": "cross-env ENVFILE=.env.development npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios && cd ios && xcodebuild -workspace jatayutechnologies.xcworkspace -scheme jatayutechnologies -configuration Debug -sdk iphonesimulator",
    "build:ios:prod": "cross-env ENVFILE=.env.production npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle --assets-dest ios && cd ios && xcodebuild -workspace jatayutechnologies.xcworkspace -scheme jatayutechnologies -configuration Release -sdk iphoneos",
    "build:apk:dev": "cross-env ENVFILE=.env.development npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleDebug",
    "build:apk:prod": "cross-env ENVFILE=.env.production npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^23.8.3",
    "@react-native-firebase/messaging": "^23.8.3",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.10.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.0",
    "axios": "^1.16.0",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "knip": "^6.14.1",
    "lucide-react-native": "^0.562.0",
    "moment": "^2.30.1",
    "npm": "^11.14.1",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-android-location-enabler": "^3.0.1",
    "react-native-asset": "^2.2.8",
    "react-native-blob-util": "^0.24.7",
    "react-native-bootsplash": "^7.0.2",
    "react-native-config": "^1.6.1",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-flash-message": "^0.4.2",
    "react-native-geocoding": "^0.5.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-get-location": "^6.0.1",
    "react-native-gifted-charts": "^1.4.73",
    "react-native-image-picker": "^8.2.1",
    "react-native-indicators": "^0.17.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keyboard-controller": "^1.21.7",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.26.20",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-size-matters": "^0.4.2",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-svg": "^15.15.4",
    "react-native-version-check": "^3.5.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-indicators": "^0.16.6",
    "@types/react-native-version-check": "^3.4.8",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
